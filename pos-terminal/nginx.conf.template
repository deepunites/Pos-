server {
    # Railway (and most PaaS) inject the port to listen on; 80 is the local default.
    # Внутренняя сеть платформы — IPv6-only, и входящий трафик приходит по
    # ней, поэтому слушаем оба стека. Штатный 10-listen-on-ipv6-by-default.sh
    # нам не помогает: он правит только неизменённый конфиг из образа.
    listen ${PORT};
    listen [::]:${PORT};
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # Апстрим живёт в приватной сети платформы, чей DNS в момент разбора
    # конфига ещё не отвечает: nginx резолвит proxy_pass на старте и падает с
    # "host not found in upstream". Переменная в proxy_pass откладывает
    # резолв до первого запроса, а resolver говорит, у кого спрашивать.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    set $backend "${BACKEND_URL}";

    # Cheap endpoint for the platform health check — it must not depend on
    # the backend being up.
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 'ok';
    }

    # Офлайн-режим: service worker и манифест браузер должен перепроверять
    # каждый раз — иначе планшет неделями сидит на старой версии кассы.
    location = /sw.js {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location = /manifest.webmanifest {
        add_header Cache-Control "no-cache";
        default_type application/manifest+json;
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api {
        proxy_pass http://$backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_cache_bypass $http_upgrade;
    }

    location /socket.io {
        proxy_pass http://$backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_cache_bypass $http_upgrade;
    }
}

generator client {
  provider = "prisma-client-js"
}

// PostgreSQL 16. До 2026-10 база была SQLite: её миграции и замороженная
// схема лежат в prisma/cutover/ — для переноса данных и отката.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                    String    @id @default(uuid())
  name                  String
  slug                  String    @unique
  // "cafe" — зал, столы, навынос; "retail" — магазин: сканер, вес, чек без столов.
  businessType          String    @default("cafe") @map("business_type")
  logoUrl               String?   @map("logo_url")
  phone                 String?
  email                 String?
  address               String?
  // Продаём в Узбекистане: новая точка сразу считает в сумах и по ташкентскому
  // времени (иначе отчёты «за сегодня» начинались бы в 5 утра).
  timezone              String    @default("Asia/Tashkent")
  currency              String    @default("UZS")
  taxRate               Float     @default(0) @map("tax_rate")
  defaultMarkupPercent  Float     @default(0) @map("default_markup_percent")
  // Делится ли магазин с общей базой штрихкодов тем, что вносит сам: штрихкод,
  // название, бренд, объём, полка. Цены и остатки не уходят никогда.
  catalogSharing        Boolean   @default(true) @map("catalog_sharing")
  subscriptionPlan      String    @default("free") @map("subscription_plan")
  subscriptionExpiresAt DateTime? @map("subscription_expires_at")
  settings              String    @default("{}")
  isActive              Boolean   @default(true) @map("is_active")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  users               User[]
  branches            Branch[]
  categories          Category[]
  products            Product[]
  orders              Order[]
  orderCounter        OrderCounter?
  idempotencyKeys     IdempotencyKey[]
  payments            Payment[]
  inventory           InventoryMovement[]
  tables              Table[]
  reservations        Reservation[]
  receipts            Receipt[]
  stockReceipts       StockReceipt[]
  cashShifts          CashShift[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  techCards           TechCard[]
  customers           Customer[]
  customerDebtEntries CustomerDebtEntry[]
  saleReturns         SaleReturn[]

  @@map("tenants")
}

model User {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email              String
  passwordHash       String    @map("password_hash")
  firstName          String    @map("first_name")
  lastName           String    @map("last_name")
  phone              String?
  pin                String?
  role               String    @default("cashier")
  avatarUrl          String?   @map("avatar_url")
  isActive           Boolean   @default(true) @map("is_active")
  // Права кассира (у администратора и менеджера разрешено всё). По умолчанию
  // всё можно — как было до них; администратор снимает галочки в карточке
  // сотрудника. Проверяются на сервере при каждом действии, не из токена:
  // снятая галочка действует сразу, без перевхода.
  canSellOnDebt      Boolean   @default(true) @map("can_sell_on_debt")
  /// Приход товара на кассе — и новые товары в нём.
  canReceiveStock    Boolean   @default(true) @map("can_receive_stock")
  /// false — «слепое» закрытие смены: сколько наличных должно быть, кассир не видит.
  canSeeExpectedCash Boolean   @default(true) @map("can_see_expected_cash")
  /// Возврат товара на кассе — по чеку и без чека.
  canRefund          Boolean   @default(true) @map("can_refund")
  // Счётчик для отзыва refresh-токенов: он пишется в токен обновления и
  // сверяется при каждом обновлении. Смена пароля увеличивает счётчик, и все
  // выданные ранее refresh-токены перестают работать. Без этого украденный
  // токен жил свои семь дней, а смена пароля его не отменяла.
  tokenVersion       Int       @default(0) @map("token_version")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  orders        Order[]
  auditLogs     AuditLog[]
  notifications Notification[]
  inventory     InventoryMovement[]
  stockReceipts StockReceipt[]
  cashShifts    CashShift[]
  saleReturns   SaleReturn[]

  @@unique([tenantId, email])
  @@map("users")
}

model Branch {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true) @map("is_active")
  settings  String   @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders       Order[]
  tables       Table[]
  reservations Reservation[]

  @@map("branches")
}

model Category {
  id            String     @id @default(uuid())
  tenantId      String     @map("tenant_id")
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentId      String?    @map("parent_id")
  parent        Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children      Category[] @relation("CategoryTree")
  name          String
  description   String?
  imageUrl      String?    @map("image_url")
  color         String?
  sortOrder     Int        @default(0) @map("sort_order")
  isIngredient  Boolean    @default(false) @map("is_ingredient")
  markupPercent Float      @default(0) @map("markup_percent")
  isActive      Boolean    @default(true) @map("is_active")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model TechCard {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  ingredients String   @default("[]")
  totalCost   Float    @default(0) @map("total_cost")
  output      Float    @default(0)
  unit        String   @default("г")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("tech_cards")
}

model Product {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId       String?   @map("category_id")
  category         Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  techCardId       String?   @map("tech_card_id")
  techCardRef      TechCard? @relation(fields: [techCardId], references: [id], onDelete: SetNull)
  name             String
  description      String?
  volume           String?
  sku              String?
  barcode          String?
  imageUrl         String?   @map("image_url")
  price            Float     @default(0)
  costPrice        Float     @default(0) @map("cost_price")
  compareAtPrice   Float?    @map("compare_at_price")
  taxRate          Float     @default(0) @map("tax_rate")
  unit             String    @default("piece")
  purchaseUnit     String?   @map("purchase_unit")
  saleUnit         String?   @map("sale_unit")
  conversionFactor Float?    @map("conversion_factor")
  minStock         Float     @default(0) @map("min_stock")
  currentStock     Float     @default(0) @map("current_stock")
  trackInventory   Boolean   @default(false) @map("track_inventory")
  isIngredient     Boolean   @default(false) @map("is_ingredient")
  techCard         String    @default("[]") @map("tech_card")
  preparationArea  String?   @map("preparation_area")
  cookingMethod    String?   @map("cooking_method")
  noDiscounts      Boolean   @default(false) @map("no_discounts")
  isActive         Boolean   @default(true) @map("is_active")
  sortOrder        Int       @default(0) @map("sort_order")
  tags             String    @default("[]")
  metadata         String    @default("{}")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  modifierGroups    ProductModifierGroup[]
  orderItems        OrderItem[]
  inventory         InventoryMovement[]
  stockReceiptItems StockReceiptItem[]
  returnItems       SaleReturnItem[]

  @@index([tenantId, categoryId])
  @@index([tenantId, barcode])
  @@index([tenantId, sku])
  @@map("products")
}

model ProductModifierGroup {
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId       String        @map("product_id")
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  modifierGroupId String        @map("modifier_group_id")

  @@id([productId, modifierGroupId])
  @@map("product_modifier_groups")
}

model ModifierGroup {
  id            String   @id @default(uuid())
  name          String
  description   String?
  isRequired    Boolean  @default(false) @map("is_required")
  minSelections Int      @default(0) @map("min_selections")
  maxSelections Int      @default(1) @map("max_selections")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")

  products      ProductModifierGroup[]
  modifierItems ModifierItem[]

  @@map("modifier_groups")
}

model ModifierItem {
  id              String        @id @default(uuid())
  modifierGroupId String        @map("modifier_group_id")
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  name            String
  price           Float         @default(0)
  costPrice       Float         @default(0) @map("cost_price")
  grossWeight     Float?        @map("gross_weight")
  imageUrl        String?       @map("image_url")
  isActive        Boolean       @default(true) @map("is_active")
  sortOrder       Int           @default(0) @map("sort_order")
  createdAt       DateTime      @default(now()) @map("created_at")

  orderItemModifiers OrderItemModifier[]

  @@map("modifier_items")
}

model Table {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId  String?  @map("branch_id")
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  number    String
  capacity  Int      @default(4)
  status    String   @default("available")
  zone      String?
  positionX Float?   @map("position_x")
  positionY Float?   @map("position_y")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders       Order[]
  reservations Reservation[]

  @@unique([tenantId, branchId, number])
  @@map("tables")
}

model Order {
  id                  String     @id @default(uuid())
  tenantId            String     @map("tenant_id")
  tenant              Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId            String?    @map("branch_id")
  branch              Branch?    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tableId             String?    @map("table_id")
  table               Table?     @relation(fields: [tableId], references: [id])
  userId              String?    @map("user_id")
  user                User?      @relation(fields: [userId], references: [id])
  cashShiftId         String?    @map("cash_shift_id")
  cashShift           CashShift? @relation(fields: [cashShiftId], references: [id])
  orderNumber         Int        @default(0) @map("order_number")
  status              String     @default("pending")
  type                String     @default("dine_in")
  subtotal            Float      @default(0)
  taxAmount           Float      @default(0) @map("tax_amount")
  discountAmount      Float      @default(0) @map("discount_amount")
  total               Float      @default(0)
  notes               String?
  customerName        String?    @map("customer_name")
  customerPhone       String?    @map("customer_phone")
  // Клиент из списка заведения — у продажи в долг он обязателен; имя и
  // телефон выше по-прежнему пишутся в чек.
  customerId          String?    @map("customer_id")
  customer            Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  estimatedReadyAt    DateTime?  @map("estimated_ready_at")
  completedAt         DateTime?  @map("completed_at")
  // Кухня — отдельно от оплаты. status говорит о деньгах (completed — продажа
  // оплачена, на нём держатся выручка, смена и склад), kitchenStatus — о том,
  // где блюдо: new → cooking → ready → served. null — кухня не участвует
  // (магазин). Оплаченный заказ кафе уходит на кухню сразу, а отчёты не ждут,
  // пока его приготовят.
  kitchenStatus       String?    @map("kitchen_status")
  kitchenStatusAt     DateTime?  @map("kitchen_status_at")
  // Офлайн-режим кассы: продажа пробита без связи и дошла до сервера позже.
  // offlineAt — когда её пробили на кассе (createdAt тоже ставится на это
  // время, чтобы отчёты по дням и часам были верными). Флаги — что было не
  // так, когда она дошла: остатка не хватило (склад ушёл в минус) или цена на
  // сервере к тому времени была другой (взяли по цене кассы).
  offlineAt           DateTime?  @map("offline_at")
  offlineShortfall    Boolean    @default(false) @map("offline_shortfall")
  offlinePriceChanged Boolean    @default(false) @map("offline_price_changed")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  items       OrderItem[]
  payments    Payment[]
  debtEntries CustomerDebtEntry[]
  receipts    Receipt[]
  saleReturns SaleReturn[]

  // Номер заказа уникален в пределах точки. На SQLite это держалось на том,
  // что писатель в базе один; на Postgres — на счётчике OrderCounter, а это
  // ограничение — страховка от любой будущей ошибки в выдаче номеров.
  @@unique([tenantId, orderNumber])
  @@index([tenantId, createdAt])
  // Для фоновой отмены неоплаченных заказов (order.cleanup.ts).
  @@index([status, createdAt])
  @@index([cashShiftId])
  // Экран кухни: заказы точки, которые ещё не выданы.
  @@index([tenantId, kitchenStatus])
  @@map("orders")
}

// Счётчик номеров заказов по точке. На SQLite номер брался как max+1 внутри
// транзакции, и гонки не было: писатель в базе один. На Postgres две
// одновременные продажи прочитали бы один и тот же max и получили одинаковый
// номер. Теперь номер выдаёт один INSERT ... ON CONFLICT DO UPDATE ... RETURNING
// по строке точки: строка заблокирована до конца транзакции, так что номера
// уникальны и идут без пропусков (откат продажи возвращает номер).
model OrderCounter {
  tenantId   String @id @map("tenant_id")
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lastNumber Int    @map("last_number")

  @@map("order_counters")
}

// Ключи идемпотентности (заголовок Idempotency-Key). Касса, у которой
// оборвалась связь посреди продажи, не знает, прошла ли продажа, и шлёт её
// ещё раз — с тем же ключом. Строка пишется в той же транзакции, что и сама
// продажа (оплата, приход): либо есть и то и другое, либо ничего, — и
// повтор возвращает уже созданное вместо второго чека. Ключ живёт сутки.
model IdempotencyKey {
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key         String
  // «POST /orders/checkout» и т.п. и SHA-256 тела запроса: тот же ключ с
  // другим запросом — ошибка клиента, а не повтор.
  route       String
  requestHash String   @map("request_hash")
  // id созданного заказа, платежа или прихода — по нему повтор и отвечает.
  resourceId  String?  @map("resource_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@id([tenantId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String   @map("product_id")
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int      @default(1)
  weightGrams Float?   @map("weight_grams")
  unitPrice   Float    @map("unit_price")
  totalPrice  Float    @map("total_price")
  notes       String?
  status      String   @default("pending")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  modifiers   OrderItemModifier[]
  returnItems SaleReturnItem[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderItemModifier {
  id             String       @id @default(uuid())
  orderItemId    String       @map("order_item_id")
  orderItem      OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierItemId String       @map("modifier_item_id")
  modifierItem   ModifierItem @relation(fields: [modifierItemId], references: [id])
  price          Float        @default(0)
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([orderItemId])
  @@map("order_item_modifiers")
}

model Payment {
  id                    String    @id @default(uuid())
  tenantId              String    @map("tenant_id")
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId               String    @map("order_id")
  order                 Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method                String
  amount                Float
  tipAmount             Float     @default(0) @map("tip_amount")
  status                String    @default("pending")
  transactionId         String?   @map("transaction_id")
  cardLastFour          String?   @map("card_last_four")
  stripePaymentIntentId String?   @map("stripe_payment_intent_id")
  metadata              String    @default("{}")
  processedAt           DateTime? @map("processed_at")
  createdAt             DateTime  @default(now()) @map("created_at")

  @@index([orderId])
  @@index([tenantId, createdAt])
  @@map("payments")
}

model InventoryMovement {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId   String   @map("product_id")
  product     Product  @relation(fields: [productId], references: [id])
  type        String
  quantity    Float
  reason      String?
  referenceId String?  @map("reference_id")
  userId      String?  @map("user_id")
  user        User?    @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([productId])
  @@map("inventory_movements")
}

model StockReceipt {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId        String?  @map("user_id")
  user          User?    @relation(fields: [userId], references: [id])
  supplierName  String?  @map("supplier_name")
  invoiceNumber String?  @map("invoice_number")
  totalAmount   Float    @default(0) @map("total_amount")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  items StockReceiptItem[]

  @@map("stock_receipts")
}

model StockReceiptItem {
  id        String       @id @default(uuid())
  receiptId String       @map("receipt_id")
  receipt   StockReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  productId String       @map("product_id")
  product   Product      @relation(fields: [productId], references: [id])
  quantity  Float
  costPrice Float        @map("cost_price")
  totalCost Float        @map("total_cost")
  createdAt DateTime     @default(now()) @map("created_at")

  @@map("stock_receipt_items")
}

model Reservation {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId        String?  @map("branch_id")
  branch          Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tableId         String?  @map("table_id")
  table           Table?   @relation(fields: [tableId], references: [id])
  customerName    String   @map("customer_name")
  customerPhone   String?  @map("customer_phone")
  customerEmail   String?  @map("customer_email")
  partySize       Int
  reservationDate DateTime @map("reservation_date")
  reservationTime DateTime @map("reservation_time")
  status          String   @default("confirmed")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("reservations")
}

model Receipt {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId   String    @map("order_id")
  order     Order     @relation(fields: [orderId], references: [id])
  template  String    @default("standard")
  content   String    @default("{}")
  printedAt DateTime? @map("printed_at")
  emailedAt DateTime? @map("emailed_at")
  emailTo   String?   @map("email_to")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("receipts")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  oldValue   String?  @map("old_value")
  newValue   String?  @map("new_value")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false) @map("is_read")
  link      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

model CashShift {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id")
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId              String    @map("user_id")
  user                User      @relation(fields: [userId], references: [id])
  status              String    @default("open")
  openingCash         Float     @default(0) @map("opening_cash")
  closingCash         Float?    @map("closing_cash")
  totalSales          Float     @default(0) @map("total_sales")
  totalCashSales      Float     @default(0) @map("total_cash_sales")
  totalCardSales      Float     @default(0) @map("total_card_sales")
  totalQrSales        Float     @default(0) @map("total_qr_sales")
  totalTips           Float     @default(0) @map("total_tips")
  totalRefunds        Float     @default(0) @map("total_refunds")
  expectedCash        Float?    @map("expected_cash")
  // Продано в долг (в ящик не попало) и погашено долгов на этой кассе.
  totalDebtSales      Float     @default(0) @map("total_debt_sales")
  totalDebtRepaidCash Float     @default(0) @map("total_debt_repaid_cash")
  totalDebtRepaidCard Float     @default(0) @map("total_debt_repaid_card")
  // Возвраты товара на этой кассе: наличные ушли из ящика, карта — на карту
  // покупателя, долг — уменьшен у клиента.
  totalReturnsCash    Float     @default(0) @map("total_returns_cash")
  totalReturnsCard    Float     @default(0) @map("total_returns_card")
  totalReturnsDebt    Float     @default(0) @map("total_returns_debt")
  difference          Float?    @map("difference")
  notes               String?
  openedAt            DateTime  @default(now()) @map("opened_at")
  closedAt            DateTime? @map("closed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  orders      Order[]
  saleReturns SaleReturn[]

  @@index([tenantId, status])
  @@map("cash_shifts")
}

// Общая база штрихкодов: по штрихкоду знает название, бренд, объём и полку, чтобы
// новый магазин не набирал товары с нуля. Не привязана к магазину — общая для всех.
model CatalogProduct {
  barcode       String   @id
  name          String
  brand         String?
  quantity      String?
  category      String?
  // "snapshot" — поставляется вместе с приложением (Open Food Facts),
  // "off" — найден вживую и запомнен, "tasnif" — из национального каталога
  // Узбекистана (tasnif.soliq.uz), "crowd" — внесён магазином.
  source        String   @default("snapshot")
  // Код ИКПУ из национального каталога — он обязателен в счёте-фактуре и чеке.
  ikpu          String?
  // Сколько магазинов внесли такое же название (только для source = "crowd").
  confirmations Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("catalog_products")
}

// Служебные значения базы штрихкодов: версия загруженной поставки и т. п.
model CatalogMeta {
  key   String @id
  value String

  @@map("catalog_meta")
}

// Покупатели заведения — для продажи в долг. Список свой у каждого заведения;
// телефон в нём не повторяется. debtBalance — текущий долг, меняется только в
// одной транзакции с записью журнала CustomerDebtEntry.
model Customer {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  firstName   String   @map("first_name")
  lastName    String?  @map("last_name")
  phone       String
  phone2      String?
  // Ручная оценка 1–5 и заметка — ставит администратор.
  rating      Int?
  note        String?
  // «Не давать в долг» вручную; метка по возрасту долга считается отдельно.
  debtBlocked Boolean  @default(false) @map("debt_blocked")
  debtBalance Float    @default(0) @map("debt_balance")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  orders      Order[]
  debtEntries CustomerDebtEntry[]

  @@unique([tenantId, phone])
  @@index([tenantId, debtBalance])
  @@map("customers")
}

// Журнал долга клиента: продажа в долг (+), погашение (−), возврат долговой
// части чека (−). Сумма записей клиента = его debtBalance.
model CustomerDebtEntry {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId  String   @map("customer_id")
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type        String // sale | repayment | refund
  amount      Float
  method      String? // cash | card — у погашения
  orderId     String?  @map("order_id")
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  cashShiftId String?  @map("cash_shift_id")
  userId      String?  @map("user_id")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId, customerId, createdAt])
  @@index([cashShiftId])
  @@map("customer_debt_entries")
}

/// Возврат товара на кассе (2026-10-05). По чеку — orderId и строки чека,
/// без чека — товары по текущей цене. Деньги отдаёт кассир: наличными, на карту
/// или в счёт долга клиента. Товар возвращается на склад, брак — нет.
model SaleReturn {
  id          String     @id @default(uuid())
  tenantId    String     @map("tenant_id")
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Номер возврата в точке: 1, 2, 3…
  number      Int
  orderId     String?    @map("order_id")
  order       Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  cashShiftId String?    @map("cash_shift_id")
  cashShift   CashShift? @relation(fields: [cashShiftId], references: [id], onDelete: SetNull)
  userId      String     @map("user_id")
  user        User       @relation(fields: [userId], references: [id])
  /// cash | card | debt
  method      String
  amount      Float
  reason      String?
  createdAt   DateTime   @default(now()) @map("created_at")

  items SaleReturnItem[]

  @@unique([tenantId, number])
  @@index([tenantId, createdAt])
  @@index([orderId])
  @@index([cashShiftId])
  @@map("sale_returns")
}

model SaleReturnItem {
  id          String     @id @default(uuid())
  returnId    String     @map("return_id")
  saleReturn  SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId String?    @map("order_item_id")
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  productId   String     @map("product_id")
  product     Product    @relation(fields: [productId], references: [id])
  name        String
  /// Штучный товар — штук; весовой — граммов в weightGrams, quantity = 1.
  quantity    Int        @default(1)
  weightGrams Float?     @map("weight_grams")
  amount      Float
  /// Брак: на склад не возвращается.
  defective   Boolean    @default(false)

  @@index([returnId])
  @@index([orderItemId])
  @@index([productId])
  @@map("sale_return_items")
}
